  "rules": [
    {
      "id": "dessert_no_option",
      "when": "category == 디저트",
      "msg": "디저트는 옵션 없이 그대로 나가요."
    },
    {
      "id": "size_from_prices",
      "when": "선택한 사이즈가 prices에 없음",
      "msg": "이 메뉴는 중 사이즈 하나만 있어요."
    },
    {
      "id": "temp_from_menu",
      "when": "선택한 온도가 temperatures에 없음",
      "msg": "이 메뉴는 ICE로만 나와요."
    },
    {
      "id": "hot_no_ice",
      "when": "HOT인데 얼음 옵션",
      "msg": "따뜻한 음료라 얼음은 안 들어가요."
    },
    {
      "id": "smoothie_no_ice",
      "when": "스무디·요거트에 얼음 옵션",
      "msg": "스무디는 얼음을 갈아 만들어서 얼음 양은 못 바꿔요."
    },
    {
      "id": "no_sugar_option",
      "when": "sugar.categories 밖의 메뉴에 당도",
      "msg": "이 메뉴는 당도를 못 바꿔요. 달게 드시려면 시럽을 추가할 수 있어요."
    },
    {
      "id": "sugar_fixed",
      "when": "sugar.overrides에서 levels가 빈 메뉴에 당도",
      "msg": "이 메뉴는 당도가 정해져 있어요. 덜 단 걸 원하시면 저당 블랙 밀크티를 추천해요."
    },
    {
      "id": "coffee_only",
      "when": "커피가 아닌 메뉴에 샷 추가·디카페인",
      "msg": "샷 추가와 디카페인은 커피 메뉴만 돼요."
    },
    {
      "id": "syrup_scope",
      "when": "커피·밀크티가 아닌 메뉴에 시럽",
      "msg": "시럽은 커피와 밀크티에만 넣을 수 있어요."
    },
    {
      "id": "oat_needs_milk",
      "when": "우유가 안 들어간 메뉴에 오트밀크",
      "msg": "이 메뉴엔 우유가 안 들어가서 바꿀 게 없어요."
    },
    {
      "id": "oat_foam_milk",
      "when": "오트밀크로 바꿨는데 밀크폼·치즈폼이 있음",
      "msg": "오트밀크로 바꿔도 폼에는 우유가 들어 있어요."
    },
    {
      "id": "topping_scope",
      "when": "커피·디저트에 토핑",
      "msg": "토핑은 밀크티, 티·과일, 스무디·요거트에만 올라가요."
    },
    {
      "id": "topping_max",
      "when": "토핑이 3개 넘음",
      "msg": "토핑은 한 잔에 3개까지예요."
    },
    {
      "id": "sold_out",
      "when": "sold_out == true",
      "msg": "지금 품절이에요. 비슷한 메뉴를 골라 드릴까요?"
    }
  ],
