{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "python3 scripts/build.py",
  "outputDirectory": "dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,scripts/**,tests/**,docs/**,artifacts/**,dist/**,*.md,run.command,.env*,.openai/**,.vercel/**,.vercel_python_packages/**,.git/**}"
    }
  }
}
