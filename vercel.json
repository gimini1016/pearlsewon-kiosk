{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{screenshots/**,templates/**,dist/**,test_*.py,*-check.mjs,app-check.js,requirements.md,.env*,.openai/**,.vercel/**,.vercel_python_packages/**,.git/**,verification.json,ai-verification.json}"
    }
  }
}
